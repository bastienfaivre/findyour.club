# ============================================================
# .env.example — All required environment variables with
# local dev default values. Copy to .env for local development.
# DO NOT commit real secrets — this file uses placeholder values only.
# ============================================================

# Database (PostgreSQL via Docker Compose)
# Local dev: docker-compose.dev.yml starts postgres on port 5432
#
# POSTGRES_* vars configure the postgres container (read by docker-compose.yml).
# DATABASE_URL must match POSTGRES_USER/PASSWORD/DB — update all four together.
# In production, change all four to real credentials (never commit real secrets).
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="website_template_dev"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/website_template_dev"

# Auth.js (NextAuth v5)
# AUTH_URL: The canonical URL of your application
# AUTH_SECRET: At least 32 chars, used to sign JWTs and session tokens
AUTH_URL="http://localhost:3000"
AUTH_SECRET="dev_secret_change_in_production_min_32_chars"

# Cloudflare R2 / MinIO (local dev uses MinIO via Docker Compose)
# MinIO console: http://localhost:9001
# MINIO_ROOT_USER/PASSWORD configure the MinIO container (read by docker-compose.dev.yml).
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY must match for local dev.
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin"
R2_ENDPOINT="http://localhost:9000"
R2_ACCESS_KEY_ID="minioadmin"
R2_SECRET_ACCESS_KEY="minioadmin"
R2_BUCKET_NAME="website-template"
R2_PUBLIC_URL="http://localhost:9000/website-template"

# Email / Resend (local dev uses Mailpit SMTP via Docker Compose)
# Mailpit inbox UI: http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
RESEND_API_KEY=""  # Leave blank for local dev (use SMTP_HOST instead)
EMAIL_FROM="noreply@platform.local"

# Cloudflare Turnstile CAPTCHA
# Official always-pass test keys for local dev — safe to commit
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Contact form encryption (AES-256-GCM)
# MUST be exactly 32 bytes in production
CONTACT_ENCRYPTION_KEY="dev_key_exactly_32_chars_padding"

# Platform settings
PLATFORM_NAME="Clashware"
PLATFORM_DOMAIN="localhost"
COOKIE_DOMAIN="localhost"
