# ============================================================
# .env.production.example — Production environment variables
# Copy to .env.production and fill in real values.
# DO NOT commit real secrets.
# ============================================================

# Database (PostgreSQL)
POSTGRES_USER="findyour_club"
POSTGRES_PASSWORD="CHANGE_ME_strong_random_password"
POSTGRES_DB="findyour_club"
DATABASE_URL="postgresql://findyour_club:CHANGE_ME_strong_random_password@postgres:5432/findyour_club"

# NextAuth v4
NEXTAUTH_URL="https://findyour.club"
NEXTAUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Cloudflare R2 (object storage for logos, photos)
R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="CHANGE_ME"
R2_SECRET_ACCESS_KEY="CHANGE_ME"
R2_BUCKET_NAME="findyour-club"
R2_PUBLIC_URL="https://cdn.findyour.club"

# Email (Resend)
RESEND_API_KEY="re_CHANGE_ME"
EMAIL_FROM="noreply@findyour.club"

# Cloudflare Turnstile CAPTCHA
# Create a site at https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="CHANGE_ME"
TURNSTILE_SECRET_KEY="CHANGE_ME"

# Contact form encryption (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
CONTACT_ENCRYPTION_KEY="CHANGE_ME_exactly_32_characters!"

# Platform settings
NEXT_PUBLIC_BASE_URL="https://findyour.club"
COOKIE_DOMAIN="findyour.club"
SUPPORT_EMAIL="support@findyour.club"

# WebAuthn / Passkeys
WEBAUTHN_RP_ID="findyour.club"
WEBAUTHN_RP_NAME="findyour.club"
WEBAUTHN_ORIGIN="https://findyour.club"

# Initial operator account (used by prisma/seed-prod.ts on first deploy)
OPERATOR_EMAIL="your-email@example.com"
OPERATOR_NAME="Your Name"
OPERATOR_INITIAL_PASSWORD="CHANGE_ME_strong_random_password"
